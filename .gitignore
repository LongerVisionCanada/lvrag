# 忽略 lvrag-local-rag-starter 目录（整个子目录）
/lvrag-local-rag-starter/

# ---- 通用忽略规则 ----
# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 环境变量 / 密钥
.env
.env.*

# IDE / 编辑器
.idea/
.vscode/
*.swp

# 系统文件
.DS_Store
Thumbs.db

# 日志与临时文件
*.log
tmp/

# ---- LVRAG private assets ----
confidential.md
*.confidential.md
/ips/**/private/
/ips/**/persona-private/
**/.local/
**/vectorstore/
**/__pycache__/
*.pyc
!.env.example

# Local repository maintenance scripts
/scripts/organize_lvrag.py
/scripts/finalize_lvrag.py

# LVRAG private IP assets
/ips/*/*/knowledge/
/ips/*/*/private/
/ips/*/*/persona-private/
/ips/*/*/confidential.md
